{
  "name": "scratchblocks-plus",
  "version": "2.0.1",
  "description": "Make pictures of Scratch blocks from text.",
  "license": "MIT",
  "author": "Lu Yifei",
  "homepage": "https://luyifei2011.github.io/scratchblocks-plus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuYifei2011/scratchblocks-plus.git"
  },
  "bugs": {
    "url": "https://github.com/LuYifei2011/scratchblocks-plus/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./build/scratchblocks-plus.min.es.js",
      "default": "./build/scratchblocks-plus.min.es.js"
    },
    "./node-ssr": {
      "types": "./node-ssr.d.ts",
      "import": "./node-ssr.js",
      "default": "./node-ssr.js"
    },
    "./node-ssr.js": {
      "types": "./node-ssr.d.ts",
      "import": "./node-ssr.js",
      "default": "./node-ssr.js"
    },
    "./syntax": {
      "types": "./syntax/index.d.ts",
      "import": "./syntax/index.js",
      "default": "./syntax/index.js"
    },
    "./syntax/index.js": {
      "types": "./syntax/index.d.ts",
      "import": "./syntax/index.js",
      "default": "./syntax/index.js"
    },
    "./locales/all": {
      "types": "./locales/all.d.ts",
      "import": "./locales/all.js",
      "default": "./locales/all.js"
    },
    "./locales/all.js": {
      "types": "./locales/all.d.ts",
      "import": "./locales/all.js",
      "default": "./locales/all.js"
    },
    "./*": "./*"
  },
  "main": "./build/scratchblocks-plus.min.es.js",
  "module": "./build/scratchblocks-plus.min.es.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "rollup -c --environment buildTarget:PROD",
    "fmt": "prettier --cache --write *.js syntax/*.js scratch2/*.js scratch3/*.js locales-src/*.js snapshots/*.js tests/*.js",
    "lint": "eslint *.js syntax/*.js scratch2/*.js scratch3/*.js locales-src/*.js snapshots/*.js tests/*.js",
    "lint:staged": "lint-staged",
    "locales": "node locales-src/build-locales.js",
    "manual": "node ./snapshots/manual.js",
    "rollup": "rollup -c",
    "snapshots": "node ./snapshots/index.js",
    "start": "rollup -c -m -w",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "types": "./index.d.ts",
  "peerDependencies": {
    "@napi-rs/canvas": "*",
    "@xmldom/xmldom": ">=0.8.0",
    "canvas": ">=2.0.0",
    "jsdom": ">=16.0.0"
  },
  "peerDependenciesMeta": {
    "@xmldom/xmldom": {
      "optional": true
    },
    "canvas": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-external-helpers": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^0.1.96",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@xmldom/xmldom": "^0.8.11",
    "cross-env": "^10.1.0",
    "csso": "^5.0.5",
    "eslint": "^10.5.0",
    "express": "^5.2.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-package-json": "^2.8.0",
    "puppeteer": "^25.1.0",
    "rollup": "^4.62.0",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-serve": "^3.0.0",
    "scratch-l10n": "^6.1.86",
    "scratch-translate-extension-languages": "^1.0.7"
  },
  "keywords": [
    "scratch"
  ],
  "jest": {
    "transform": {}
  },
  "jsdelivr": "./build/scratchblocks-plus.min.js",
  "lint-staged": {
    "package.json": [
      "prettier-package-json --write",
      "git add"
    ],
    "*.js": [
      "prettier --write",
      "git add"
    ]
  },
  "pre-commit": "lint:staged",
  "prettier": {
    "semi": false,
    "trailingComma": "all",
    "arrowParens": "avoid"
  },
  "unpkg": "./build/scratchblocks-plus.min.js"
}
